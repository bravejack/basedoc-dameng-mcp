{
  "name": "basedoc-dameng-mcp",
  "version": "0.1.2",
  "description": "面向达梦数据库 (DM8) 的只读 MCP 服务：受限 SQL 查询 + 本地 Markdown 手册离线全文检索（list_manuals / list_sections / read_section / lookup_docs）。",
  "type": "module",
  "license": "MIT",
  "author": "bravejack",
  "homepage": "https://github.com/bravejack/basedoc-dameng-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bravejack/basedoc-dameng-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/bravejack/basedoc-dameng-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dameng",
    "dm8",
    "claude",
    "anthropic",
    "database",
    "documentation"
  ],
  "bin": {
    "basedoc-dameng-mcp": "dist/server.js",
    "basedoc-dameng-fetch-docs": "dist/bin-fetch.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/server.js dist/bin-fetch.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dmdb": "1.0.48286",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/turndown": "5.0.6",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.10"
  }
}
